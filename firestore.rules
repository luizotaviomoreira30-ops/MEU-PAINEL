rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Login Google com e-mail verificado.
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    // O dono do painel administra quem tem acesso.
    function isOwner() { return signedIn() && email() == "luizotaviomoreira30@gmail.com"; }
    // Pessoas liberadas pelo dono, na lista config/access (campo emails).
    function isListed() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/access)
        && email() in get(/databases/$(database)/documents/config/access).data.emails;
    }
    function allowed() { return isOwner() || isListed(); }

    // A lista de acesso: quem está nela pode ler (para o app confirmar a entrada); só o dono altera.
    match /config/access {
      allow read: if allowed();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(["emails", "updatedAt"])
        && request.resource.data.emails is list
        && request.resource.data.emails.size() <= 20;
    }

    // Cada pessoa só lê e grava a própria pasta. Ninguém vê os dados de outra pessoa, nem o dono.
    match /users/{uid}/{document=**} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }
  }
}
